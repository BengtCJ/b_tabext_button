<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.bengtcj.b_tabext_button" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Back navigation button. Reads the Source Dashboard parameter and returns the user to the correct parent dashboard.</description>
    <author name="BengtCJ" email="" organization="" website="https://github.com/BengtCJ"/>
    <min-api-version>1.7</min-api-version>
    <source-location>
      <url>https://BengtCJ.github.io/b_tabext_button/index.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAACXBIWXMAAAsTAAALEwEAmpwYAAAAB3RJTUUH4wYcDCsBOm8DVAAAACZJREFUOMtj/P///38GKgMmKtcPAAAA//8DADqpBgEfmu4DAAAAAElFTkSuQmCC</icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <resources>
      <resource id="name">
        <text locale="en_US">Back Nav Button</text>
      </resource>
    </resources>
  </dashboard-extension>
</manifest>
